;; Rebinding a key here? Update docs/kanata.md too (it's a doc, not
;; generated from this file, so it drifts silently otherwise). Also
;; note the actual WM-side action for a given Super+X signal lives in
;; each host's own doc (docs/hyprland.md, docs/aerospace.md) and can
;; drift independently of what's written here.

;; Force Kanata reload
(defcfg
  process-unmapped-keys yes
  macos-dev-names-include (
    "HHKB-Hybrid_2"
  )
)

;; -------------------------------------------------------------------
;; 物理キー監視対象の宣言 (defsrc)
;; 実際のキーボードの物理配列に沿って視覚的に整列しています．
;; -------------------------------------------------------------------
(defsrc
  caps  lalt  spc   ralt  lctl  esc
  grv   1     2     3     4     5     6     7     8     9
  tab   q     w     e     r     t     y     u     i     o     p     ret
  a     s     d     f     g     h     j     k     l
  z     x     c     v     b     n     m
  left  down  up    rght
  f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12 ;; frow-src
)

;; -------------------------------------------------------------------
;; キーエイリアス（マッピング定義）
;; -------------------------------------------------------------------
(defalias
  ;; 左右Alt単押しでのIME切り替え（Tap：英数/かな / Hold：隠しレイヤー）
  alt-eng  (tap-hold-press 200 200 eisu (layer-toggle alt-layer))
  alt-jp   (tap-hold-press 200 200 kana (layer-toggle alt-layer))

  ;; CapsLock長押しでのCtrl化（Tap：Esc -> 英数 / Hold：Left Ctrl。全ホスト共通で素のCtrl）
  esc-eng  (macro esc eisu)
  cap-ctrl (tap-hold-press 200 200 @esc-eng lctl)

  ;; スペースキー長押しでのナビゲーションレイヤー移行（Tap：Space / Hold：Nav-Layer）
  spc-nav  (tap-hold-press 200 200 spc (layer-toggle nav))

  ;; Superwhisper 起動用マクロ (Right Control / Push-to-Talk)
  whisper  rctl

  alt-ctrl-toggle (layer-toggle alt-ctrl-layer)
)

;; -------------------------------------------------------------------
;; WMショートカット信号の定義（ホスト別の差分は platform で切り替える）
;; 以前は Nix 側で "wmmodifier-" を文字列置換していたが、kanata 自身の
;; platform / deftemplate で解決する。引数の意味:
;;   p      : 通常のWM修飾子の接頭辞 (macOS=Ctrl+Cmd / Linux=Super / Windows=Alt)
;;   close  : Alt+q の信号 (macOSはCmd+Shift+Q=ログアウト衝突回避で w にずらす)
;;   dact   : Alt+Space の動作 (macOS/WindowsはOS標準のAlt+Spaceをそのまま通す)
;;   tabact : Alt+Tab の動作 (macOSはAltTabアプリ連携、Windowsはhold中のAltでOS標準)
;;   cp     : alt-ctrl-layer (join-with) 用の接頭辞
;; -------------------------------------------------------------------
(deftemplate wm-aliases (p close dact tabact cp)
  (defalias
    ;; =================================================================
    ;; Alt長押し（Alt-Layer）時の Super（lmet）ショートカットの定義
    ;; =================================================================
    hyp-q       (concat $p $close) ;; Alt + q   -> Super + Shift + w（閉じる - macOSログアウト衝突回避）
    hyp-d       $dact              ;; Alt + Spc -> Super + d（Rofi/Spotlight起動等）
    hyp-ret     (concat $p ret)    ;; Alt + Ent -> Super + Enter（端末起動）
    hyp-tab     $tabact            ;; Alt + Tab -> Super + Tab（窓一覧切り替え）
    hyp-f       (concat $p f)      ;; Alt + f   -> Super + f（フルスクリーン）
    hyp-t       (concat $p t)      ;; Alt + d   -> Super + t（タイリング復元）
    hyp-sft-spc (concat $p S-spc)  ;; Alt + t   -> Super + Shift + Space（浮動切替）

    ;; 窓の直接リサイズ
    hyp-u       (concat $p u)      ;; Alt + u   -> Super + u（幅を縮小）
    hyp-i       (concat $p i)      ;; Alt + i   -> Super + i（高さを縮小）
    hyp-o       (concat $p o)      ;; Alt + o   -> Super + o（高さを拡大）
    hyp-p       (concat $p p)      ;; Alt + p   -> Super + p（幅を拡大）

    ;; ワークスペース移動
    hyp-s       (concat $p s)      ;; Alt + s   -> Super + s（次のWSへ）
    hyp-a       (concat $p a)      ;; Alt + a   -> Super + a（前のWSへ）
    hyp-grv     (concat $p grv)    ;; Alt + `   -> Super + `（直前のWSへ戻る）

    ;; ワークスペース 1-9 へ切り替え
    hyp-1       (concat $p 1)      
    hyp-2       (concat $p 2)      
    hyp-3       (concat $p 3)      
    hyp-4       (concat $p 4)      
    hyp-5       (concat $p 5)      
    hyp-6       (concat $p 6)      
    hyp-7       (concat $p 7)      
    hyp-8       (concat $p 8)      
    hyp-9       (concat $p 9)      

    ;; ウィンドウの移動・最小化・分割方向
    hyp-h       (concat $p h)      ;; Alt + h   -> Super + h（左へフォーカス）
    hyp-j       (concat $p j)      ;; Alt + j   -> Super + j（下へフォーカス）
    hyp-k       (concat $p k)      ;; Alt + k   -> Super + k（上へフォーカス）
    hyp-l       (concat $p l)      ;; Alt + l   -> Super + l（右へフォーカス）
    hyp-m       (concat $p m)      ;; Alt + m   -> Super + m（最小化）
    hyp-v       (concat $p v)      ;; Alt + v   -> Super + v（分割トグル）

    ;; その他のアプリケーション・ツール用 Super ショートカット
    hyp-w       (concat $p w)      ;; Alt + w   -> Super + w（壁紙ピッカー）
    hyp-b       (concat $p b)      ;; Alt + b   -> Super + b（ブラウザ）
    hyp-c       (concat $p c)      ;; Alt + c   -> Super + c（カラーピッカー）
    hyp-r       (concat $p r)      ;; Alt + r   -> Super + r（Waybarリスタート）
    hyp-e       (concat $p e)      ;; Alt + e   -> Super + e（ファイルマネージャ）
    hyp-y       (concat $p y)      ;; Alt + y   -> Super + y（Yazi起動）
    hyp-n       (concat $p n)      ;; Alt + n   -> Super + n（Neovim起動）
    hyp-left    (concat $p left)   ;; Alt + Left -> Super + Left
    hyp-down    (concat $p down)   ;; Alt + Down -> Super + Down
    hyp-up      (concat $p up)     ;; Alt + Up -> Super + Up
    hyp-rght    (concat $p rght)   ;; Alt + Right -> Super + Right
    hyp-ctrl-h  (concat $cp h)     ;; Alt + Ctrl + h -> Super + Alt + h
    hyp-ctrl-j  (concat $cp j)     ;; Alt + Ctrl + j -> Super + Alt + j
    hyp-ctrl-k  (concat $cp k)     ;; Alt + Ctrl + k -> Super + Alt + k
    hyp-ctrl-l  (concat $cp l)     ;; Alt + Ctrl + l -> Super + Alt + l
  )
)

(platform (macos)
  (t! wm-aliases C-M- S-w A-spc A-tab C-M-A-)
)
(platform (linux)
  (t! wm-aliases M- S-w M-d M-tab M-A-)
)
(platform (win winiov2 wintercept)
  (t! wm-aliases A- S-q A-spc _ C-A-)
)

;; Nav-Layer の U = Undo。macOS は Cmd+Z、それ以外は Ctrl+Z
(deftemplate undo-alias (k) (defalias undo-key $k))
(platform (macos) (t! undo-alias M-z))
(platform (linux win winiov2 wintercept) (t! undo-alias C-z))

;; -------------------------------------------------------------------
;; デフォルトのベースレイヤー（通常時）
;; -------------------------------------------------------------------
(deflayer base
  @cap-ctrl @alt-eng @spc-nav @alt-jp @cap-ctrl @esc-eng
  grv   1     2     3     4     5     6     7     8     9
  tab   q     w     e     r     t     y     u     i     o     p     ret
  a     s     d     f     g     h     j     k     l
  _     _     _     _     _     _     _
  left  down  up    rght
  @fk1  @fk2  @fk3  @fk4  f5    f6    @fk7  @fk8  @fk9  @fk10 @fk11 @fk12 ;; frow-base
)

;; -------------------------------------------------------------------
;; 左右Alt長押し時のエミュレーションレイヤー（Alt-Layer）
;; すべてのウィンドウマネージャー操作が Alt キーの組み合わせだけで発動します．
;; -------------------------------------------------------------------
(deflayer alt-layer
  @alt-ctrl-toggle _ @hyp-d _ @alt-ctrl-toggle _
  @hyp-grv @hyp-1 @hyp-2 @hyp-3 @hyp-4 @hyp-5 @hyp-6 @hyp-7 @hyp-8 @hyp-9
  @hyp-tab @hyp-q @hyp-w @hyp-e @hyp-r @hyp-sft-spc @hyp-y @hyp-u @hyp-i @hyp-o @hyp-p @hyp-ret
  @hyp-a @hyp-s @hyp-t @hyp-f _     @hyp-h @hyp-j @hyp-k @hyp-l
  _     _     @hyp-c @hyp-v @hyp-b @hyp-n @hyp-m
  @hyp-left @hyp-down @hyp-up @hyp-rght
  _     _     _     _     _     _     _     _     _     _     _     _ ;; frow-l1
)

;; -------------------------------------------------------------------
;; スペース長押し時の高速ナビゲーションレイヤー（Nav-Layer）
;; -------------------------------------------------------------------
(deflayer nav
  _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _
  _     _     _     end   _     _     _     @undo-key _     _     _     _
  home  _     @whisper _  _     left  down  up    right
  _     del   _     _     bspc  _     _
  _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _ ;; frow-l2
)

;; -------------------------------------------------------------------
;; Alt + Ctrl が同時に押された際のエミュレーションレイヤー（Alt-Ctrl-Layer）
;; ウィンドウ結合（join-with）などの高度なWMレイアウト操作を行います．
;; -------------------------------------------------------------------
(deflayer alt-ctrl-layer
  _     _     _            _     _     _
  _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     @hyp-ctrl-h @hyp-ctrl-j @hyp-ctrl-k @hyp-ctrl-l
  _     _     _     _     _     _     _
  _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _ ;; frow-l3
)

;; -------------------------------------------------------------------
;; ファンクション行 (F1-F12)
;; macOS 内蔵キーボードの F 行は、単独押しでメディア機能 (輝度・音量等) を送る。
;; kanata が入力を横取りすると素の F キーとして再送されメディア機能が失われるため、
;; macOS だけ明示的にメディアキーへ割り当てる。他OSは素の F キーのまま。
;; (Fn 併用で本来の F キーに戻す機能は、kanata が Fn を検知できるか未確認のため未実装)
;; -------------------------------------------------------------------
(deftemplate fkeys (k1 k2 k3 k4 k7 k8 k9 k10 k11 k12)
  (defalias
    fk1 $k1 fk2 $k2 fk3 $k3 fk4 $k4
    fk7 $k7 fk8 $k8 fk9 $k9 fk10 $k10 fk11 $k11 fk12 $k12
  )
)
(platform (macos)
  (t! fkeys brdn brup mctl lpad prev pp next mute vold volu)
)
(platform (linux win winiov2 wintercept)
  (t! fkeys f1 f2 f3 f4 f7 f8 f9 f10 f11 f12)
)

;; -------------------------------------------------------------------
;; macOS: Fn を押している間だけ F1-F12 を本来の F キーにする
;; 内蔵キーボードの F 行は単独押しがメディアキー (上の fkeys)。Fn 併用で素の F キー。
;; Fn キー自体も素通しする (multi fn ...) ので、Globe キーの標準機能 (絵文字等) は
;; 残る想定だが、kanata が Fn を検知・再送できるかは実機確認が必要。
;; fn 列は構造差分なので mac-config.nix が defsrc と各レイヤーの F 行末尾に追加する
;; (frow-* コメントを目印に置換)。Linux / WSL には fn 列は無く、この節は評価されない。
;; -------------------------------------------------------------------
(platform (macos)
  (defalias fnk (multi fn (layer-while-held fnrow)))
)
(platform (macos)
  (deflayer fnrow
    _     _     _     _     _     _     _     _
    _     _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     _
    _     _     _     _
    f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12   _
  )
)
